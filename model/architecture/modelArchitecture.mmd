graph TD
    %% Input Images
    A1[Input Image 1] --> B1[Conv Block 1]
    A2[Input Image 2] --> B2[Conv Block 1]
    
    %% Shared Convolutional Blocks (both images use same weights)
    B1 --> C1[Conv Block 2]
    B2 --> C2[Conv Block 2]
    
    C1 --> D1[Conv Block 3]
    C2 --> D2[Conv Block 3]
    
    D1 --> E1[Conv Block 4]
    D2 --> E2[Conv Block 4]
    
    %% Spatial Attention
    E1 --> F1[Spatial Attention]
    E2 --> F2[Spatial Attention]
    
    %% Feature Concatenation
    F1 --> G[Concatenate Features]
    F2 --> G
    
    %% Final Conv Processing
    G --> H[Final Conv Processing]
    H --> I[Global Avg Pooling]
    
    %% Dynamic Input Branch
    J[Speed Input] --> K[Dense 32, Tanh]
    K --> L[BatchNorm]
    
    %% Feature Fusion
    I --> M[Feature Fusion]
    L --> M
    
    %% Fully Connected Layers
    M --> N[Dense 2048, ReLU]
    N --> O[Dropout 0.5]
    O --> P[Dense 1024, ReLU]
    P --> Q[Dropout 0.5]
    Q --> R[Dense 512, ReLU]
    R --> S[Dropout 0.3]
    S --> T[Dense 128, ReLU]
    T --> U[Dense 12]
    U --> V[Reshape to 6,2]
    
    %% Final Output
    V --> W[Trajectory Output]
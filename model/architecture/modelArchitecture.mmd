flowchart LR
  %% TrajectoryModel: MotionFpnEncoder + Transformer decoder
  subgraph Inputs
    frameT["Frame t"]
    frameT_mdt["Frame t-Δt"]
  end

  subgraph Encoder["MotionFpnEncoder"]
    subgraph BackboneT["MotionBackbone (Frame t)"]
      t_stem["Stem: Conv5x5 + Residual"]
      t_stage1["Stage1: Downsample + Residual"]
      t_stage2["Stage2: Downsample + Residual"]
      t_stage3["Stage3: Downsample + Residual"]
    end
    subgraph BackboneT_mdt["MotionBackbone (Frame t-Δt)"]
      tm1_stem["Stem: Conv5x5 + Residual"]
      tm1_stage1["Stage1: Downsample + Residual"]
      tm1_stage2["Stage2: Downsample + Residual"]
      tm1_stage3["Stage3: Downsample + Residual"]
    end
    shared["Shared weights"]
    feat8T["Features t (1/8)"]
    feat16T["Features t (1/16)"]
    feat8T_mdt["Features t-Δt (1/8)"]
    feat16T_mdt["Features t-Δt (1/16)"]
    motion8["Concat: feat8_t, feat8_t-Δt, (feat8_t - feat8_t-Δt)"]
    motion16["Concat: feat16_t, feat16_t-Δt, (feat16_t - feat16_t-Δt)"]
    fuse8["1x1 Conv fuse8"]
    fuse16["1x1 Conv fuse16"]
    up16["Upsample fused16"]
    fpn["FPN fuse (3x3 Conv)"]
    coords["Add x/y frame-space coordinate channels"]
  end

  subgraph Decoder["VectorTransformerDecoder"]
    memProj["1x1 Conv memory projection"]
    memFlat["Flatten HxW → tokens"]
    memNorm["LayerNorm"]
    query["Learned queries"]
    timeEmbed["Time MLP
    (vectorTimes)"]
    querySum["Query + time embed"]

    subgraph Xformer["Transformer decoder (x2 layers)"]
      selfAttn["Self-attention (queries)"]
      crossAttn["Cross-attention (memory)"]
      ffn["FFN (GELU)"]
      addNorm1["Residual + LayerNorm"]
      addNorm2["Residual + LayerNorm"]
      addNorm3["Residual + LayerNorm"]
    end

    outHead["MLP → (dx, dy)"]
  end

  subgraph Outputs
    traj["Predicted trajectory vectors"]
    attn["Attention maps (cross-attention)"]
    aux["Aux dynamics (optional)"]
  end

  frameT ~~~ shared
  Inputs ~~~ shared

  frameT --> t_stem
  t_stem --> t_stage1
  t_stage1 --> t_stage2
  t_stage2 --> t_stage3

  frameT_mdt --> tm1_stem
  tm1_stem --> tm1_stage1
  tm1_stage1 --> tm1_stage2
  tm1_stage2 --> tm1_stage3

  t_stage2 --> feat8T
  t_stage3 --> feat16T
  tm1_stage2 --> feat8T_mdt
  tm1_stage3 --> feat16T_mdt

  shared -.-> BackboneT
  shared -.-> BackboneT_mdt

  feat8T --> motion8
  feat8T_mdt --> motion8
  feat16T --> motion16
  feat16T_mdt --> motion16

  motion8 --> fuse8
  motion16 --> fuse16
  fuse16 --> up16
  fuse8 --> fpn
  up16 --> fpn
  fpn --> coords

  coords --> memProj
  coords ~~~ query
  memProj --> memFlat
  memFlat --> memNorm
  memNorm --> crossAttn
  query --> querySum
  timeEmbed --> querySum
  querySum --> selfAttn
  selfAttn --> addNorm1
  addNorm1 --> crossAttn
  crossAttn --> addNorm2
  addNorm2 --> ffn
  ffn --> addNorm3
  addNorm3 --> outHead
  outHead --> traj
  addNorm3 --> attn

  coords -.-> aux

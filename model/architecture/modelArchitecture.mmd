flowchart LR
  %% TrajectoryModel: MotionFpnEncoder + Transformer decoder
  subgraph Inputs
    imgT["Frame t"]
    imgTm1["Frame t-0.1s"]
  end

  subgraph Encoder["MotionFpnEncoder"]
    subgraph BackboneT["MotionBackbone (Frame t)"]
      t_stem["Stem: Conv5x5 + Residual"]
      t_stage1["Stage1: Downsample + Residual"]
      t_stage2["Stage2: Downsample + Residual"]
      t_stage3["Stage3: Downsample + Residual"]
    end
    subgraph BackboneTm1["MotionBackbone (Frame t-0.1s)"]
      tm1_stem["Stem: Conv5x5 + Residual"]
      tm1_stage1["Stage1: Downsample + Residual"]
      tm1_stage2["Stage2: Downsample + Residual"]
      tm1_stage3["Stage3: Downsample + Residual"]
    end
    shared["Shared weights"]
    feat8T["Features t (1/8)"]
    feat16T["Features t (1/16)"]
    feat8Tm1["Features t-0.1s (1/8)"]
    feat16Tm1["Features t-0.1s (1/16)"]
    motion8["Concat: feat8T, feat8Tm1, (feat8T - feat8Tm1)"]
    motion16["Concat: feat16T, feat16Tm1, (feat16T - feat16Tm1)"]
    fuse8["1x1 Conv fuse8"]
    fuse16["1x1 Conv fuse16"]
    up16["Upsample fused16"]
    fpn["FPN fuse (3x3 Conv)"]
    coords["Add x/y coord channels"]
  end

  subgraph Decoder["VectorTransformerDecoder"]
    memProj["1x1 Conv memory proj"]
    memFlat["Flatten HxW > tokens"]
    memNorm["LayerNorm"]
    query["Learned queries
    +
    time embedding"]
    xformer["Transformer decoder"]
    outHead["MLP > (dx, dy)"]
  end

  subgraph Outputs
    traj["Predicted trajectory vectors"]
    attn["Attention maps (placeholder)"]
    aux["Aux dynamics (optional)"]
  end

  Inputs ~~~ shared

  imgT --> t_stem
  t_stem --> t_stage1
  t_stage1 --> t_stage2
  t_stage2 --> t_stage3

  imgTm1 --> tm1_stem
  tm1_stem --> tm1_stage1
  tm1_stage1 --> tm1_stage2
  tm1_stage2 --> tm1_stage3

  t_stage2 --> feat8T
  t_stage3 --> feat16T
  tm1_stage2 --> feat8Tm1
  tm1_stage3 --> feat16Tm1

  shared -.-> BackboneT
  shared -.-> BackboneTm1

  feat8T --> motion8
  feat8Tm1 --> motion8
  feat16T --> motion16
  feat16Tm1 --> motion16

  motion8 --> fuse8
  motion16 --> fuse16
  fuse16 --> up16
  fuse8 --> fpn
  up16 --> fpn
  fpn --> coords

  coords --> memProj
  memProj --> memFlat
  memFlat --> memNorm
  memNorm --> xformer
  query --> xformer
  xformer --> outHead
  outHead --> traj
  xformer --> attn

  coords -.-> aux

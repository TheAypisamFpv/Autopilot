graph TD
    %% Image Processing Branch for First Image
    A1[Input Image 1] --> B1[Conv2D]
    B1 --> C1[BatchNorm]
    C1 --> D1[MaxPooling]
    D1 --> E1[Conv2D]
    E1 --> F1[BatchNorm]

    %% Image Processing Branch for Second Image
    A2[Input Image 2] --> B2[Conv2D]
    B2 --> C2[BatchNorm]
    C2 --> D2[MaxPooling]
    D2 --> E2[Conv2D]
    E2 --> F2[BatchNorm]

    %% Cross-Attention Layer
    F1 --> G[Cross-Attention]
    F2 --> G
    G --> H1[MaxPooling]
    G --> H2[MaxPooling]

    %% Further Processing for Image 1
    H1 --> I1[Conv2D]
    I1 --> J1[BatchNorm]
    J1 --> K1[Conv2D]
    K1 --> L1[BatchNorm]
    L1 --> M1[MaxPooling]

    %% Further Processing for Image 2
    H2 --> I2[Conv2D]
    I2 --> J2[BatchNorm]
    J2 --> K2[Conv2D]
    K2 --> L2[BatchNorm]
    L2 --> M2[MaxPooling]

    %% Concatenation of Image Features
    M1 --> N[Concatenate]
    M2 --> N

    %% Dynamic Input Processing Branch
    O[Dynamic Input] --> P[Dense]
    P --> Q[BatchNorm]

    %% Feature Fusion
    N --> R[Concatenate]
    Q --> R

    %% Fully Connected Layers
    R --> S[Dense]
    S --> T[Dropout]
    T --> U[Dense]
    U --> V[Dropout]
    V --> W[Dense]

    %% Output Layer
    W --> X[Dense]
    X --> Y[Reshape]